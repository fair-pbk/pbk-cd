### PBK Model for Cadmium ###

model PBK_Cd()

    # Units of the model :
    unit day = 3600*24 seconds;
    unit substance = 1e-6 gram;
    unit microg_kg = 1e-6 gram/1000 grams;
    unit volume = 1 liter;
    unit kg = 1000 grams;
    unit g = 1 gram;
    unit area = m^2;

    # Parameters

    ## Exposure parameters (in µg/kg/day)

    ### Body weight in function of the age and the sex (in kg)
    BW := (3.938425 + 0.7518199*Age*12 - 0.02023793*(Age*12)^2 + 0.0002921682*(Age*12)^3 - 2.06762e-6*(Age*12)^4 + 8.469e-09*(Age*12)^5 - 2.188427e-11*(Age*12)^6 + 3.699776e-14*(Age*12)^7 - 4.099077e-17*(Age*12)^8 + 2.874804e-20*(Age*12)^9 - 1.159732e-23*(Age*12)^10 + 2.052602e-27*(Age*12)^11)*DeltaBW
    DeltaBW = 1

    Age_init = 0                    # Age at the beginning of the simulation
    Age := (Age_init + time/365)    # Evolution of the age (in years)

    # Kinetic parameters
    C1_cig = 0.1
    C1_dust = 0.7
    C2_cig = 0.4
    C2_dust = 0.13
    C3 = 0.05
    C4 = 0.005
    C5 = 0.048
    C6 = 0.05
    C7 = 0.25
    C8 = 1000
    I2 := piecewise(C7*QExpo, C7*QExpo<C8, C8)
    C9 = 0.44
    C10 = 0.00014
    C11 = 0.27
    C12 = 0.25
    C13 = 0.00003
    C14 = 0.00016
    C15 = 0.00005
    C16 = 0.012
    C17 := piecewise(0.95, Age < 30, 0.95-(0.95/3)*(Age-30)/50)
    C18 = 0.00001
    C19 := piecewise(0.00014, Age < 30, 0.00014+C21*(Age-30))
    C20 = 0.1
    C21 = 0.0000011
    CX = 0.04

    # Concentration of creatinine over lifetime
    VCreat := piecewise((0.032+2.098e-02*Age+9.104e-03*(Age^2)-4.550e-04*(Age^3)+7.578e-06*(Age^4)-4.232e-08*(Age^5)),Age < 70,(0.032+2.098e-02*70+9.104e-03*(70^2)-4.550e-04*(70^3)+7.578e-06*(70^4)-4.232e-08*(70^5)))

    # Compartments
    compartment Liver = 1                   # Compartment of liver (only the quantity)
    compartment Kidney = 1                  # Compartment of kidneys (only the quantity)
    compartment Others = 1                  # Compartment of other tissues (only the quantity)
    compartment Feces = 1                   # Compartment of feces (only the quantity)
    compartment Urine = 2                   # Compartment of urine (2L of urine per day)
    compartment Intestine = 1               # Compartment of intestine (only the quantity)
    compartment Gut = 1                     # Compartment of gut (input compartment)
    compartment Lung = 1                    # Compartment of lungs (only the quantity)
    compartment Expo = 1                    # Compartment of daily intake (only the quantity)
    compartment Excretion = 1               # Compartment of the total excretion (only the quantity)
    compartment Plasma = 1                  # Compartment of Plasma (only the quantity)
    compartment RBC = 1                     # Compartment of Red Blood Cells (only the quantity)
    compartment Metallothionein = 1         # Compartment of Metallothionein (only the quantity)

    # Species
    substanceOnly species AGut in Gut                         # Quantity of cadmium in gut (µg)
    substanceOnly species ALiver in Liver                     # Quantity of cadmium in liver (µg)
    substanceOnly species AKidney in Kidney                   # Quantity of cadmium in kidneys (µg)
    substanceOnly species AExpo in Expo                       # Total of cadmium intaken in the day (µg)
    substanceOnly species ALung in Lung                       # Quantity of cadmium in lungs (µg)
    substanceOnly species AUrine in Urine                     # Concentration of cadmium in urine considering creatinine excretion
    substanceOnly species AFeces in Feces                     # Quantity of cadmium in feces (µg)
    substanceOnly species AIntestine in Intestine             # Quantity of cadmium in intestine (µg)
    substanceOnly species APlasma in Plasma                   # Quantity of cadmium in plasma (µg)
    substanceOnly species ARBC in RBC                         # Quantity of cadmium in red blood cells (µg)
    substanceOnly species ABlood3 in Metallothionein          # Quantity of cadmium in metallothionein (µg)
    substanceOnly species AOthers in Others                   # Quantity of cadmium in the rest of the body (µg)

    # Initial amounts
    AGut             = 0
    ALiver           = 0
    AKidney          = 0
    AExpo            = 0
    ALung            = 0
    AUrine           = 0
    AFeces           = 0
    AExcretion       = 0
    AIntestine       = 0
    APlasma          = 0
    ARBC             = 0
    AMetallothionein = 0
    AOthers          = 0

    # Reactions
    AGut          -> AIntestine;  (AGut + ALung*C4)*C5
    ALung         -> AExpo;       ALung*C3
    AIntestine    -> AExpo;       AIntestine*C6
    AExpo         -> ABlood3;     I2
    AExpo         -> ABlood1;     AExpo - I2
    APlasma       -> AOthers;     APlasma*C9
    APlasma       -> ARBC;        APlasma*CX
    AOthers       -> APlasma;     AOthers*C10
    APlasma       -> AFeces;      APlasma*C11
    APlasma       -> ALiver;      APlasma*C12
    ALiver        -> APlasma;     ALiver*C13
    ALiver        -> AMetallothionein;     ALiver*C14
    ALiver        -> AFeces;      ALiver*C15
    ARBC          -> AMetallothionein;     ARBC*C16
    AMetallothionein       -> AKidney;     AMetallothionein*C17
    AKidney       -> ABlood1;     AKidney*C18
    AKidney       -> AUrine;      AKidney*C19
    AMetallothionein       -> AUrine;      AMetallothionein*(1-C17)

end
