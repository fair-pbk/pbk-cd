### PBK Model for Cadmium ###

model PBK_Cd()

    # Parameters

    ## Physiology

    ### Body weight in function of the age and the sex (in kg)
    BW := (3.938425 + 0.7518199*Age*12 - 0.02023793*(Age*12)^2 + 0.0002921682*(Age*12)^3 - 2.06762e-6*(Age*12)^4 + 8.469e-09*(Age*12)^5 - 2.188427e-11*(Age*12)^6 + 3.699776e-14*(Age*12)^7 - 4.099077e-17*(Age*12)^8 + 2.874804e-20*(Age*12)^9 - 1.159732e-23*(Age*12)^10 + 2.052602e-27*(Age*12)^11)*DeltaBW
    DeltaBW = 1
    Age_init = 0                    # Age at the beginning of the simulation
    Age := (Age_init + time/365)    # Evolution of the age (in years)

    # Kinetic parameters
    C3 = 0.05                           # Rate of transfer of inhalation intake to uptake pool
    C4 = 0.005                          # Rate of transfer of air Cd to the GI-tract
    C5 = 0.048                          # Fraction of GI-tract Cd retained in epithelium
    C6 = 0.05                           # Rate of transfer of Cd in the GI-tract to uptake pool
    C7 = 0.25                           # Fraction of uptake pool transferred to blood
    C8 = 1000                           # Maximum mass of Cd in uptake pool
    I2 := piecewise(C7*AExpo, C7*AExpo<C8, C8)
    C9 = 0.44                           # Rate of transfer from plasma to other tissues
    C10 = 0.00014                       # Rate of transfer of Cd in other tissues to plasma
    C11 = 0.27                          # Rate of transfer of Cd in plasma to feces
    C12 = 0.25                          # Rate of transfer of Cd in plasma to liver
    C13 = 0.00003                       # Rate of transfer of Cd in liver to plasma
    C14 = 0.00016                       # Rate of transfer of Cd in liver to metallothionein
    C15 = 0.00005                       # Rate of transfer of Cd in liver to feces
    C16 = 0.012                         # Rate of transfer of Cd in blood red blodd cells to metallothionein
    C17 := piecewise(0.95, Age < 30, 0.95-(0.95/3)*(Age-30)/50)     # Rate of transfer of Cd in metallothionein to kidney
    C18 = 0.00001                       # Rate of transfer of Cd in kidney to plasma
    C19 := piecewise(0.00014, Age < 30, 0.00014+C21*(Age-30))       # Age-specific rate constant for transfer of Cd in kidney to urine
    C20 = 0.1                           # Increased transfer of Cd from kidney to urine after age 30
    C21 = 0.0000011                     # Fraction of Cd in plasma and red blood cells that contribute to cadmium in whole blood
    CX = 0.04                           # Rate of transfer of Cd in B1 to blood B2

    # Concentration of creatinine over lifetime
    VCreat := piecewise((0.032+2.098e-02*Age+9.104e-03*(Age^2)-4.550e-04*(Age^3)+7.578e-06*(Age^4)-4.232e-08*(Age^5)),Age < 70,(0.032+2.098e-02*70+9.104e-03*(70^2)-4.550e-04*(70^3)+7.578e-06*(70^4)-4.232e-08*(70^5)))

    # Compartments
    compartment Liver = 1                   # Liver
    compartment Kidney = 1                  # Kidneys
    compartment Rest = 1                    # Other tissues
    compartment Feces = 1                   # Feces
    compartment Urine = 2                   # Urine (2L of urine per day)
    compartment Intestine = 1               # Intestine (gut lumen)
    compartment Gut = 1                     # Gut (input compartment)
    compartment Lung = 1                    # Lungs
    compartment Expo = 1                    # Daily systemic intake
    compartment Excretion = 1               # Total excretion
    compartment Plasma = 1                  # Plasma
    compartment RBC = 1                     # Red Blood Cells
    compartment Metallothionein = 1         # Metallothionein

    # Species
    substanceOnly species AGut in Gut                         # Quantity of cadmium in gut (µg)
    substanceOnly species ALiver in Liver                     # Quantity of cadmium in liver (µg)
    substanceOnly species AKidney in Kidney                   # Quantity of cadmium in kidneys (µg)
    substanceOnly species AExpo in Expo                       # Total of cadmium intaken in the day (µg)
    substanceOnly species ALung in Lung                       # Quantity of cadmium in lungs (µg)
    substanceOnly species AUrine in Urine                     # Concentration of cadmium in urine considering creatinine excretion
    substanceOnly species AFeces in Feces                     # Quantity of cadmium in feces (µg)
    substanceOnly species AIntestine in Intestine             # Quantity of cadmium in intestine (µg)
    substanceOnly species APlasma in Plasma                   # Quantity of cadmium in plasma (µg)
    substanceOnly species ARBC in RBC                         # Quantity of cadmium in red blood cells (µg)
    substanceOnly species AMetallothionein in Metallothionein # Quantity of cadmium in metallothionein (µg)
    substanceOnly species ARest in Rest                       # Quantity of cadmium in the rest of the body (µg)

    # Initial amounts
    AGut             = 0
    ALiver           = 0
    AKidney          = 0
    AExpo            = 0
    ALung            = 0
    AUrine           = 0
    AFeces           = 0
    AExcretion       = 0
    AIntestine       = 0
    APlasma          = 0
    ARBC             = 0
    AMetallothionein = 0
    ARest            = 0

    # Reactions
    AGut              -> AIntestine;        (AGut + ALung*C4)*C5
    ALung             -> AExpo;             ALung*C3
    AIntestine        -> AExpo;             AIntestine*C6
    AExpo             -> AMetallothionein;  I2
    AExpo             -> APlasma;           AExpo - I2
    APlasma           -> ARest;             APlasma*C9
    APlasma           -> ARBC;              APlasma*CX
    ARest             -> APlasma;           ARest*C10
    APlasma           -> AFeces;            APlasma*C11
    APlasma           -> ALiver;            APlasma*C12
    ALiver            -> APlasma;           ALiver*C13
    ALiver            -> AMetallothionein;  ALiver*C14
    ALiver            -> AFeces;            ALiver*C15
    ARBC              -> AMetallothionein;  ARBC*C16
    AMetallothionein  -> AKidney;           AMetallothionein*C17
    AKidney           -> APlasma;           AKidney*C18
    AKidney           -> AUrine;            AKidney*C19
    AMetallothionein  -> AUrine;            AMetallothionein*(1-C17)

end
