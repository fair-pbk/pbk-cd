### PBK Model for Cadmium ###

function f_BW(Age)
    (3.938425 + 0.7518199*Age*12 - 0.02023793*(Age*12)^2 + 0.0002921682*(Age*12)^3 - 2.06762e-6*(Age*12)^4 + 8.469e-09*(Age*12)^5 - 2.188427e-11*(Age*12)^6 + 3.699776e-14*(Age*12)^7 - 4.099077e-17*(Age*12)^8 + 2.874804e-20*(Age*12)^9 - 1.159732e-23*(Age*12)^10 + 2.052602e-27*(Age*12)^11)
end

function f_Metallothionein_Kidney(Age)
    piecewise(0.95, Age < 30, 0.95-(0.95/3)*(Age-30)/50)
end

function f_Kidney_Urine(Age, Increase_Cd_Urine)
    piecewise(0.00014, Age < 30, 0.00014 + Increase_Cd_Urine * (Age - 30))
end

model PBK_Cd()

    # Parameters

    ## Physiological parameters
    DeltaBW = 1
    BW := f_BW(Age)*DeltaBW             # Body weight as function age [kg]
    Age := time/365                     # Evolution of the age (in years)

    ## Kinetic parameters
    Fabs = 0.048                        # Fraction of GI-tract Cd retained in epithelium
    Ka = 0.05                           # Rate of transfer of Cd in the GI-tract to uptake pool
    K_Inhalation_Uptake = 0.05          # Rate of transfer of inhalation intake to uptake pool
    K_Lung_Intestine = 0.005            # Rate of transfer of Cd in lungs to the GI-tract
    F_Uptake_Metallothionein = 0.25     # Fraction of uptake pool transferred to metallothionein
    Max_Metallothionein = 1             # Maximum mass of Cd that can bind to metallothionein per day
    K_Plasma_Others = 0.44              # Transfer from plasma to the rest of the body
    K_Others_Plasma = 0.00014           # Transfer from rest of the body to plasma
    K_Plasma_Feces = 0.27               # Transfer from plasma to feces
    K_Plasma_Liver = 0.25               # Transfer from plasma to liver
    K_Liver_Plasma = 0.00003            # Transfer from liver to plasma
    K_Liver_Metallothionein = 0.00016   # Transfer from liver to metallothionein
    K_Liver_Feces = 0.00005             # Transfer from liver to feces
    K_RBC_Metallothionein = 0.012       # Transfer from red blood cells to metallothionein
    K_Metallothionein_Kidney := f_Metallothionein_Kidney(Age)
    K_Kidney_Plasma = 0.00001           # Transfer from kidney to plasma
    K_Kidney_Urine := f_Kidney_Urine(Age, Increase_Cd_Urine) # Transfer from kidney to urine
    Increase_Cd_Urine = 0.0000011       # Temporal factor increasing Cd elimination in urine
    K_Plasma_RBC = 0.04                 # Transfer from plasma to red blood cells

    # Physiological parameters
    VLiverc = 0.025                   # Fraction of the volume of liver
    VKidneyc = 0.004                  # Fraction of the volume of kidney
    VGutc = 0.0182                    # Fraction of the volume of gut
    VLungc = 0.0068                   # Fraction of the volume of lung
    VBloodc = 0.076                   # Fraction of the volume of blood
    HCT = 0.425                       # Hematocrit

    VBlood := VBloodc * BW            # Blood volume [L]

    # Compartments
    compartment Metallothionein = 1                    # Compartment of Metallothionein [L]
    compartment Liver := VLiverc * BW                  # Compartment of liver [L]
    compartment Kidney := VKidneyc * BW                # Compartment of kidneys [L]
    compartment Feces = 1                              # Compartment of feces [L]
    compartment Urine = 1                              # Compartment of urine [L]
    compartment Gut := VGutc * BW                      # Compartment of gut tissues [L]
    compartment Lung := VLungc * BW                    # Compartment of lungs [L]
    compartment Plasma := VBlood * (1 - HCT)           # Compartment of Plasma [L]
    compartment RBC := VBlood * HCT                    # Compartment of Red Blood Cells [L]
    compartment Others := BW - (Liver + Kidney + Gut + Lung + VBlood)  # Compartment of other tissues [L]

    # Species
    substanceOnly species AGut in Gut                         # Quantity of cadmium in gut (µg)
    substanceOnly species ALiver in Liver                     # Quantity of cadmium in liver (µg)
    substanceOnly species AKidney in Kidney                   # Quantity of cadmium in kidneys (µg)
    substanceOnly species ALung in Lung                       # Quantity of cadmium in lungs (µg)
    substanceOnly species AUrine in Urine                     # Cumulative quantity of cadmium in urine (µg)
    substanceOnly species AFeces in Feces                     # Quantity of cadmium in feces (µg)
    substanceOnly species APlasma in Plasma                   # Quantity of cadmium in plasma (µg)
    substanceOnly species ARBC in RBC                         # Quantity of cadmium in red blood cells (µg)
    substanceOnly species AMetallothionein in Metallothionein # Quantity of cadmium in metallothionein (µg)
    substanceOnly species AOthers in Others                   # Quantity of cadmium in the rest of the body (µg)

    # Initial amounts
    AGut             = 0
    ALiver           = 0
    AKidney          = 0
    ALung            = 0
    AUrine           = 0
    AFeces           = 0
    APlasma          = 0
    ARBC             = 0
    AMetallothionein = 0
    AOthers          = 0

    # Total uptake [amount per day]
    Uptake :=  AGut * Ka * Fabs + ALung * K_Inhalation_Uptake + ALung * K_Lung_Intestine * Fabs

    # Uptake in Metallothionein [amount per day]
    Uptake_Metallothionein := F_Uptake_Metallothionein * Uptake

    # Transfer from gut to plasma [amount per day]
    Gut_Plasma_NoLimit := (1 - F_Uptake_Metallothionein) * AGut * Ka * Fabs + ALung * K_Lung_Intestine * Fabs
    Gut_Plasma_Limit := (AGut * Ka * Fabs + ALung * K_Lung_Intestine * Fabs) - Max_Metallothionein * ((AGut * Ka * Fabs + ALung * K_Lung_Intestine * Fabs) / Uptake)
    Gut_Plasma := piecewise(Gut_Plasma_NoLimit, Uptake_Metallothionein < Max_Metallothionein, Gut_Plasma_Limit)

    # Transfer from lung to plasma [amount per day]
    Lung_Plasma_NoLimit := (1 - F_Uptake_Metallothionein) * ALung * K_Inhalation_Uptake
    Lung_Plasma_Limit := ALung * K_Inhalation_Uptake - Max_Metallothionein * (ALung * K_Inhalation_Uptake / Uptake)
    Lung_Plasma := piecewise(Lung_Plasma_NoLimit, Uptake_Metallothionein < Max_Metallothionein, Lung_Plasma_Limit)

    # Reactions
    AGut          -> APlasma;           Gut_Plasma
    AGut          -> AMetallothionein;  (AGut * Ka * Fabs + ALung * K_Lung_Intestine * Fabs) - Gut_Plasma
    AGut          -> AFeces;            AGut * (1 - Fabs)
    ALung         -> APlasma;           Lung_Plasma
    ALung         -> AMetallothionein;  ALung * K_Inhalation_Uptake - Lung_Plasma
    ALung         -> AIntestine;        ALung * K_Lung_Intestine
    APlasma       -> AOthers;           APlasma * K_Plasma_Others
    APlasma       -> ARBC;              APlasma * K_Plasma_RBC
    APlasma       -> AFeces;            APlasma * K_Plasma_Feces
    APlasma       -> ALiver;            APlasma * K_Plasma_Liver
    ARBC          -> AMetallothionein;  ARBC * K_RBC_Metallothionein
    AMetallothionein -> AKidney;        AMetallothionein * K_Metallothionein_Kidney
    AMetallothionein -> AUrine;         AMetallothionein * (1 - K_Metallothionein_Kidney)
    ALiver        -> APlasma;           ALiver * K_Liver_Plasma
    ALiver        -> AMetallothionein;  ALiver * K_Liver_Metallothionein
    ALiver        -> AFeces;            ALiver * K_Liver_Feces
    AKidney       -> APlasma;           AKidney * K_Kidney_Plasma
    AKidney       -> AUrine;            AKidney * K_Kidney_Urine
    AOthers       -> APlasma;           AOthers * K_Others_Plasma

end
