### PBK Model for Cadmium ###

function f_BW(Age)
    (3.938425 + 0.7518199*Age*12 - 0.02023793*(Age*12)^2 + 0.0002921682*(Age*12)^3 - 2.06762e-6*(Age*12)^4 + 8.469e-09*(Age*12)^5 - 2.188427e-11*(Age*12)^6 + 3.699776e-14*(Age*12)^7 - 4.099077e-17*(Age*12)^8 + 2.874804e-20*(Age*12)^9 - 1.159732e-23*(Age*12)^10 + 2.052602e-27*(Age*12)^11)
end

function f_Metallothionein_Kidney(Age)
    piecewise(0.95, Age < 30, 0.95-(0.95/3)*(Age-30)/50)
end

function f_Kidney_Urine(Age, Increase_Cd_Urine)
    piecewise(0.00014, Age < 30, 0.00014 + Increase_Cd_Urine * (Age - 30))
end

model PBK_Cd()

    # Parameters

    ## Physiological parameters
    DeltaBW = 1
    BW := f_BW(Age)*DeltaBW          # Body weight as function age [kg]
    Age := time/365                  # Evolution of the age (in years)

    ## Kinetic parameters
    Inhalation_intake = 0.05         # Rate of transfer of inhalation intake to uptake pool
    Lung_Intestine = 0.005           # Rate of transfer of Cd in lungs to the GI-tract
    Fabs = 0.048                     # Fraction of GI-tract Cd retained in epithelium
    Ka = 0.05                        # Rate of transfer of Cd in the GI-tract to uptake pool
    Uptake_Metallothionein = 0.25    # Fraction of uptake pool transferred to metallothionein
    Max_Metallothionein = 1          # Maximum mass of Cd that can bind to metallothionein per day
    Plasma_Others = 0.44             # Transfer from plasma to the rest of the body
    Others_Plasma = 0.00014          # Transfer from rest of the body to plasma
    Plasma_Feces = 0.27              # Transfer from plasma to feces
    Plasma_Liver = 0.25              # Transfer from plasma to liver
    Liver_Plasma = 0.00003           # Transfer from liver to plasma
    Liver_Metallothionein = 0.00016  # Transfer from liver to metallothionein
    Liver_Feces = 0.00005            # Transfer from liver to feces
    RBC_Metallothionein = 0.012      # Transfer from reb blood cells to metallothionein
    Metallothionein_Kidney := f_Metallothionein_Kidney(Age)
    Kidney_Plasma = 0.00001          # Transfer from kidney to plasma
    Kidney_Urine := f_Kidney_Urine(Age, Increase_Cd_Urine) # Transfer from kidney to urine
    Increase_Cd_Urine = 0.0000011    # Temporal factor increasing Cd elimination in urine
    Plasma_RBC = 0.04                # Transfer from plasma to red blood cells

    # Total uptake [amount per day]
    Uptake :=  AGut * Ka + ALung * Inhalation_intake
    
    # Uptake in Metallothionein [amount per day]
    Uptake_Amount_Metallothionein :=  Uptake_Metallothionein * Uptake
    
    # The daily uptake in Metallothionein may not be higher than `Max_Metallothionein`
    # If the uptake exceeds the maximum allowed, we compute the fraction by which it exceeds, 
    # such that we can correct the uptake accordingly
    #Uptake_correction_fraction := piecewise(1, Uptake_Amount_Metallothionein < Max_Metallothionein, Max_Metallothionein/Uptake_Amount_Metallothionein)
    
    # Calculate uptake [amount per day]
    # => Uptake_Amount_Metallothionein is the dose transfered to metallothionein from Gut and Lung
    #Gut_Plasma := (1 - Uptake_Amount_Metallothionein * Uptake_correction_fraction) * AGut * Ka 
    #Lung_Plasma := (1 - Uptake_Amount_Metallothionein * Uptake_correction_fraction) * ALung * Inhalation_intake
    #Gut_Metallothionein := Uptake_Amount_Metallothionein * Uptake_correction_fraction * AGut * Ka 
    #Lung_Metallothionein := Uptake_Amount_Metallothionein * Uptake_correction_fraction * ALung * Inhalation_intake

    Nomax_Plasma_Gut := (1- Uptake_Metallothionein) * AGut * Ka
    Nomax_Plasma_Lung := (1 - Uptake_Metallothionein) * ALung * Inhalation_intake
    
    Max_Plasma_Gut := AGut * Ka - Max_Metallothionein * (AGut * Ka / (AGut * Ka + ALung * Inhalation_intake))
    Max_Plasma_Lung := ALung * Inhalation_intake - Max_Metallothionein * (ALung * Inhalation_intake / (AGut * Ka + ALung * Inhalation_intake))
    
    Gut_Plasma_limited := piecewise(Nomax_Plasma_Gut , Uptake_Amount_Metallothionein < Max_Metallothionein, Max_Plasma_Gut)
    Lung_Plasma_limited := piecewise(Nomax_Plasma_Lung, Uptake_Amount_Metallothionein < Max_Metallothionein, Max_Plasma_Lung)
    
    Gut_Metallothionein_limited := (AGut * Ka) - Gut_Plasma_limited
    Lung_Metallothionein_limited := ALung * Inhalation_intake - Lung_Plasma_limited

    # Excretion via feces (the fraction which is not absorbed in the body)
    Intestine_Feces := AGut * (1 - Fabs)

    # Physiological parameters
    VLiverc = 0.025     ## Fraction of the volume of liver
    VKidneyc = 0.004    ## Fraction of the volume of kidney
    VGutc = 0.0182      ## Fraction of the volume of gut
    VLungc = 0.0068     ## Fraction of the volume of lung
    VBloodc = 0.076     ## Fraction of the volume of blood
    HCT = 0.425         ## Hematocrit

    VLiver  := VLiverc * BW         ## Volume of liver (in L)
    VKidney := VKidneyc * BW        ## Volume of kidney (in L)
    VGut    := VGutc * BW           ## Volume of gut (in L)
    VLung   := VLungc * BW          ## Volume of lung (in L)
    VBlood  := VBloodc * BW         ## Volume of blood (in L)
    VPlasma := VBlood * (1 - HCT)   ## Volume of plasma (in L)
    VRCB    := VBlood * HCT         ## Volume of red blood cells (in L)

    VOther  := BW - (VLiver + VKidney + VGut + VLung + VBlood)  ## Volume of the restbody

    # Compartments
    compartment Intestine = 1                # Comportment of intestine (gut lumen) (input compartment)
    compartment Liver := VLiver              # Compartment of liver (only the quantity)
    compartment Kidney := VKidney            # Compartment of kidneys (only the quantity)
    compartment Others := VOther             # Compartment of other tissues (only the quantity)
    compartment Feces = 1                    # Compartment of feces (only the quantity)
    compartment Urine = 1                    # Compartment of urine (only the quantity)
    compartment Gut := VGut                  # Compartment of gut tissues (only quantity)
    compartment Lung := VLung                # Compartment of lungs (only the quantity)
    compartment Plasma := VPlasma            # Compartment of Plasma (only the quantity)
    compartment RBC := VRCB                  # Compartment of Red Blood Cells (only the quantity)
    compartment Metallothionein = 1          # Compartment of Metallothionein (only the quantity)

    # Species
    substanceOnly species AIntestine in Intestine             # Quantity of cadmium in intestine (µg)
    substanceOnly species AGut in Gut                         # Quantity of cadmium in gut (µg)
    substanceOnly species ALiver in Liver                     # Quantity of cadmium in liver (µg)
    substanceOnly species AKidney in Kidney                   # Quantity of cadmium in kidneys (µg)
    substanceOnly species ALung in Lung                       # Quantity of cadmium in lungs (µg)
    substanceOnly species AUrine in Urine                     # Concentration of cadmium in urine considering creatinine excretion
    substanceOnly species AFeces in Feces                     # Quantity of cadmium in feces (µg)
    substanceOnly species APlasma in Plasma                   # Quantity of cadmium in plasma (µg)
    substanceOnly species ARBC in RBC                         # Quantity of cadmium in red blood cells (µg)
    substanceOnly species AMetallothionein in Metallothionein # Quantity of cadmium in metallothionein (µg)
    substanceOnly species AOthers in Others                   # Quantity of cadmium in the rest of the body (µg)

    # Initial amounts
    AIntestine       = 0
    AGut             = 0
    ALiver           = 0
    AKidney          = 0
    ALung            = 0
    AUrine           = 0
    AFeces           = 0
    APlasma          = 0
    ARBC             = 0
    AMetallothionein = 0
    AOthers          = 0

    # Reactions
    AIntestine    -> AGut;              AIntestine * Fabs
    AGut          -> APlasma;           Gut_Plasma_limited
    AGut          -> AMetallothionein;  Gut_Metallothionein_limited
    AIntestine    -> AFeces;            Intestine_Feces

    ALung         -> APlasma;           Lung_Plasma_limited
    ALung         -> AMetallothionein;  Lung_Metallothionein_limited
    ALung         -> AIntestine;        ALung * Lung_Intestine

    APlasma       -> AOthers;           APlasma * Plasma_Others
    APlasma       -> ARBC;              APlasma* Plasma_RBC
    AOthers       -> APlasma;           AOthers * Others_Plasma
    APlasma       -> AFeces;            APlasma * Plasma_Feces
    APlasma       -> ALiver;            APlasma * Plasma_Liver
    ALiver        -> APlasma;           ALiver * Liver_Plasma
    ALiver        -> AMetallothionein;  ALiver * Liver_Metallothionein
    ALiver        -> AFeces;            ALiver * Liver_Feces
    ARBC          -> AMetallothionein;  ARBC * RBC_Metallothionein
    AMetallothionein -> AKidney;        AMetallothionein * Metallothionein_Kidney
    AKidney       -> APlasma;           AKidney * Kidney_Plasma
    AKidney       -> AUrine;            AKidney * Kidney_Urine
    AMetallothionein -> AUrine;         AMetallothionein * (1 - Metallothionein_Kidney)

end
