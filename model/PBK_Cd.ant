### PBK Model for Cadmium ###
#function f_Metallothionein_limited(Uptake_Metallothionein, Uptake, Max_Metallothionein)
#    piecewise(1- Uptake_Metallothionein, Uptake < Max_Metallothionein, Max_Metallothionein)
#end
# Problem: 

function f_Gut_Plasma_limited(Nomax_Plasma_Gut, Uptake, Max_Metallothionein, Max_Plasma_Gut)
    piecewise(Nomax_Plasma_Gut , Uptake < Max_Metallothionein, Max_Plasma_Gut)
end

function f_Lung_Plasma_limited(Nomax_Plasma_Lung, Uptake, Max_Metallothionein, Max_Plasma_Lung)
    piecewise(Nomax_Plasma_Lung, Uptake < Max_Metallothionein, Max_Plasma_Lung)
end

function f_BW(Age)
    (3.938425 + 0.7518199*Age*12 - 0.02023793*(Age*12)^2 + 0.0002921682*(Age*12)^3 - 2.06762e-6*(Age*12)^4 + 8.469e-09*(Age*12)^5 - 2.188427e-11*(Age*12)^6 + 3.699776e-14*(Age*12)^7 - 4.099077e-17*(Age*12)^8 + 2.874804e-20*(Age*12)^9 - 1.159732e-23*(Age*12)^10 + 2.052602e-27*(Age*12)^11)
end

function f_Metallothionein_Kidney(Age)
    piecewise(0.95, Age < 30, 0.95-(0.95/3)*(Age-30)/50)
end

function f_Kidney_Urine(Age, Increase_Cd_Urine)
    piecewise(0.00014, Age < 30, 0.00014 + Increase_Cd_Urine * (Age - 30))
end

model PBK_Cd()

    # Parameters

    ## Physiological parameters
    DeltaBW = 1
    BW := f_BW(Age)*DeltaBW          # Body weight as function age [kg]
    Age := time/365                  # Evolution of the age (in years)

    ## Kinetic parameters
    Inhalation_intake = 0.05         # Rate of transfer of inhalation intake to uptake pool
    Lung_Gut = 0.005                 # Rate of transfer of Cd in lungs to the GI-tract
    Fabs = 0.048                     # Fraction of GI-tract Cd retained in epithelium
    Ka = 0.05                        # Rate of transfer of Cd in the GI-tract to uptake pool
    Uptake_Metallothionein = 0.25    # Fraction of uptake pool transferred to metallothionein
    Max_Metallothionein = 1          # Maximum mass of Cd in metallothionein
    
    Uptake := Uptake_Metallothionein * (AGut * Fabs * Ka + ALung * (Lung_Gut * Ka + Inhalation_intake))

    Nomax_Plasma_Gut := (1- Uptake_Metallothionein) * AGut * Fabs * Ka
    Nomax_Plasma_Lung := (1 - Uptake_Metallothionein) * ALung * (Lung_Gut * Ka + Inhalation_intake)
    
    Max_Plasma_Gut := AGut * Fabs * Ka - Max_Metallothionein * (AGut * Fabs * Ka / (AGut * Fabs * Ka + ALung * (Lung_Gut * Ka + Inhalation_intake)))
    Max_Plasma_Lung := ALung * (Lung_Gut * Ka + Inhalation_intake) - Max_Metallothionein * (ALung * (Lung_Gut * Ka + Inhalation_intake) / (AGut * Fabs * Ka + ALung * (Lung_Gut * Ka + Inhalation_intake)))
    
    Gut_Plasma_limited := f_Gut_Plasma_limited(Nomax_Plasma_Gut, Uptake, Max_Metallothionein, Max_Plasma_Gut)
    Lung_Plasma_limited := f_Lung_Plasma_limited(Nomax_Plasma_Lung, Uptake, Max_Metallothionein, Max_Plasma_Lung)
    
    Gut_Metallothionein_limited := (AGut * Fabs * Ka) - Gut_Plasma_limited
    Lung_Metallothionein_limited := ALung * (Lung_Gut * Ka + Inhalation_intake) - Lung_Plasma_limited

    Plasma_Others = 0.44             # Transfer from plasma to the rest of the body
    Others_Plasma = 0.00014          # Transfer from rest of the body to plasma
    Plasma_Feces = 0.27              # Transfer from plasma to feces
    Plasma_Liver = 0.25              # Transfer from plasma to liver
    Liver_Plasma = 0.00003           # Transfer from liver to plasma
    Liver_Metallothionein = 0.00016  # Transfer from liver to metallothionein
    Liver_Feces = 0.00005            # Transfer from liver to feces
    RBC_Metallothionein = 0.012      # Transfer from reb blood cells to metallothionein
    Metallothionein_Kidney := f_Metallothionein_Kidney(Age)
    Kidney_Plasma = 0.00001          # Transfer from kidney to plasma
    Kidney_Urine := f_Kidney_Urine(Age, Increase_Cd_Urine) # Transfer from kidney to urine
    Increase_Cd_Urine = 0.0000011    # Temporal factor increasing Cd elimination in urine
    Plasma_RBC = 0.04                # Transfer from plasma to red blood cells

    Gut_Feces := (AGut * Fabs * Ka) - Gut_Plasma_limited - Gut_Metallothionein_limited

    # Compartments
    compartment Liver = 1                   # Compartment of liver (only the quantity)
    compartment Kidney = 1                  # Compartment of kidneys (only the quantity)
    compartment Others = 1                  # Compartment of other tissues (only the quantity)
    compartment Feces = 1                   # Compartment of feces (only the quantity)
    compartment Urine = 1                   # Compartment of urine (only the quantity)
    compartment Gut = 1                     # Compartment of gut (input compartment)
    compartment Lung = 1                    # Compartment of lungs (only the quantity)
    compartment Plasma = 1                  # Compartment of Plasma (only the quantity)
    compartment RBC = 1                     # Compartment of Red Blood Cells (only the quantity)
    compartment Metallothionein = 1         # Compartment of Metallothionein (only the quantity)

    # Species
    substanceOnly species AGut in Gut                         # Quantity of cadmium in gut (µg)
    substanceOnly species ALiver in Liver                     # Quantity of cadmium in liver (µg)
    substanceOnly species AKidney in Kidney                   # Quantity of cadmium in kidneys (µg)
    substanceOnly species ALung in Lung                       # Quantity of cadmium in lungs (µg)
    substanceOnly species AUrine in Urine                     # Concentration of cadmium in urine considering creatinine excretion
    substanceOnly species AFeces in Feces                     # Quantity of cadmium in feces (µg)
    substanceOnly species APlasma in Plasma                   # Quantity of cadmium in plasma (µg)
    substanceOnly species ARBC in RBC                         # Quantity of cadmium in red blood cells (µg)
    substanceOnly species AMetallothionein in Metallothionein # Quantity of cadmium in metallothionein (µg)
    substanceOnly species AOthers in Others                   # Quantity of cadmium in the rest of the body (µg)

    # Initial amounts
    AGut             = 0
    ALiver           = 0
    AKidney          = 0
    ALung            = 0
    AUrine           = 0
    AFeces           = 0
    APlasma          = 0
    ARBC             = 0
    AMetallothionein = 0
    AOthers          = 0

    # Reactions
    ## Problem : Uptake_Metallothionein_limited is a dose per day, it cannot be used a factor: ALung -> AMetallothionein; ALung * (Lung_Gut * Ka + Inhalation_intake) * Uptake_Metallothionein_limited
    ## Problem : Uptake_Metallothionein_limited is a dose per day, it cannot be used a factor: ALung -> APlasma; ALung * (Lung_Gut * Ka + Inhalation_intake) * (1 - Uptake_Metallothionein_limited)
    ## Problem : Uptake_Metallothionein_limited is a dose per day, it cannot be used a factor: AGut -> AMetallothionein; AGut * Fabs * Ka * Uptake_Metallothionein_limited
    ## Problem : Uptake_Metallothionein_limited is a dose per day, it cannot be used a factor: AGut -> APlasma; AGut * Fabs * Ka * (1 - Uptake_Metallothionein_limited)

    AGut          -> APlasma;           Gut_Plasma_limited
    AGut          -> AMetallothionein;  Gut_Metallothionein_limited

    AGut          -> AFeces;            Gut_Feces

    ALung         -> APlasma;           Lung_Plasma_limited
    ALung         -> AMetallothionein;  Lung_Metallothionein_limited

    APlasma       -> AOthers;           APlasma * Plasma_Others
    APlasma       -> ARBC;              APlasma* Plasma_RBC
    AOthers       -> APlasma;           AOthers * Others_Plasma
    APlasma       -> AFeces;            APlasma * Plasma_Feces
    APlasma       -> ALiver;            APlasma * Plasma_Liver
    ALiver        -> APlasma;           ALiver * Liver_Plasma
    ALiver        -> AMetallothionein;  ALiver * Liver_Metallothionein
    ALiver        -> AFeces;            ALiver * Liver_Feces
    ARBC          -> AMetallothionein;  ARBC * RBC_Metallothionein
    AMetallothionein -> AKidney;        AMetallothionein * Metallothionein_Kidney
    AKidney       -> APlasma;           AKidney * Kidney_Plasma
    AKidney       -> AUrine;            AKidney * Kidney_Urine
    AMetallothionein -> AUrine;         AMetallothionein * (1 - Metallothionein_Kidney)

end
