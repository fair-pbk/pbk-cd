    <listOfRules>
      <assignmentRule variable="BW">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <ci> f_BW </ci>
              <ci> Age </ci>
            </apply>
            <ci> DeltaBW </ci>
          </apply>
        </math>
