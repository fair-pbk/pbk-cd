    <listOfFunctionDefinitions>
      <functionDefinition id="f_Uptake_Metallothionein_limited">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <lambda>
            <bvar>
              <ci> Uptake_Metallothionein </ci>
            </bvar>
            <bvar>
              <ci> AMetallothionein </ci>
            </bvar>
            <bvar>
              <ci> Max_Metallothionein </ci>
            </bvar>
            <piecewise>
              <piece>
                <ci> Uptake_Metallothionein </ci>
                <apply>
                  <lt/>
                  <ci> AMetallothionein </ci>
                  <ci> Max_Metallothionein </ci>
                </apply>
              </piece>
              <otherwise>
                <cn type="integer"> 0 </cn>
              </otherwise>
            </piecewise>
          </lambda>
        </math>
      </functionDefinition>
      <functionDefinition id="f_BW">
