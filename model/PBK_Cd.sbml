            <ci> Age </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Kidney_Urine">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <ci> f_Kidney_Urine </ci>
            <ci> Age </ci>
            <ci> Increase_Cd_Urine </ci>
          </apply>
        </math>
      </assignmentRule>
    </listOfRules>
