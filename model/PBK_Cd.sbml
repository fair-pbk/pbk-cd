      <functionDefinition id="f_Metallothionein_Kidney">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <lambda>
            <bvar>
              <ci> Age </ci>
            </bvar>
            <piecewise>
              <piece>
                <cn> 0.95 </cn>
                <apply>
                  <lt/>
                  <ci> Age </ci>
                  <cn type="integer"> 30 </cn>
                </apply>
              </piece>
              <otherwise>
                <apply>
                  <minus/>
                  <cn> 0.95 </cn>
                  <apply>
                    <divide/>
                    <apply>
                      <times/>
                      <apply>
                        <divide/>
                        <cn> 0.95 </cn>
                        <cn type="integer"> 3 </cn>
                      </apply>
                      <apply>
                        <minus/>
                        <ci> Age </ci>
                        <cn type="integer"> 30 </cn>
                      </apply>
                    </apply>
                    <cn type="integer"> 50 </cn>
                  </apply>
                </apply>
              </otherwise>
            </piecewise>
          </lambda>
        </math>
      </functionDefinition>
      <functionDefinition id="f_Kidney_Urine">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <lambda>
            <bvar>
              <ci> Age </ci>
            </bvar>
            <bvar>
              <ci> Increase_Cd_Urine </ci>
            </bvar>
            <piecewise>
              <piece>
                <cn> 0.00014 </cn>
                <apply>
                  <lt/>
                  <ci> Age </ci>
                  <cn type="integer"> 30 </cn>
                </apply>
              </piece>
              <otherwise>
                <apply>
                  <plus/>
                  <cn> 0.00014 </cn>
                  <apply>
                    <times/>
                    <ci> Increase_Cd_Urine </ci>
                    <apply>
                      <minus/>
                      <ci> Age </ci>
                      <cn type="integer"> 30 </cn>
                    </apply>
                  </apply>
                </apply>
              </otherwise>
            </piecewise>
          </lambda>
        </math>
      </functionDefinition>
    </listOfFunctionDefinitions>
