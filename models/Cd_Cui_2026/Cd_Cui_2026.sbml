      <parameter id="C1" name="Fraction of inhaled Cd that is deposited in nasopharyngeal and tracheobronchial regions but ending up being orally ingested" value="0.1" units="UNITLESS" constant="true"/>
      <parameter id="C5" name="Fraction of Cd in GI tract to be absorbed" value="0.05" units="UNITLESS" constant="true"/>
      <parameter id="C7" name="Fraction of Cd absorbed as CdMT" value="0.25" units="UNITLESS" constant="true"/>
      <parameter id="C3" name="Rate constant of absorption of Cd in Lung to ETB" value="0.05" units="PER_DAY" constant="true"/>
      <parameter id="C4" name="Rate constant of transfer of Cd in Lung to GI-tract" value="0.005" units="PER_DAY" constant="true"/>
      <parameter id="C6" name="Rate constant of absorption of Cd in Intestine lumen to Liver Blood" value="0.05" units="PER_DAY" constant="true"/>
      <parameter id="C8" name="Maximum CdMT absorption rate" value="1" units="PER_DAY" constant="true"/>
      <parameter id="k5" name="Rate constant of dissociation of plasma protein-bound Cd (CdPP) into Free Cd and PP" value="20" units="PER_DAY" constant="true"/>
      <parameter id="k6" name="Rate constant of association of Free Cd and PP to form CdPP" value="80" units="PER_DAY" constant="true"/>
      <parameter id="CX" name="Rate constant of sequestration of Free Cd into RBC" value="4" units="PER_DAY" constant="true"/>
      <parameter id="C16" name="Rate constant of CdRBC turnover" value="0.012" units="PER_DAY" constant="true"/>
      <parameter id="f9" name="Coefficient of CdMT efflux from Liver Tissue to Liver Blood relative to Liver Blood flow" value="5e-07" units="UNITLESS" constant="true"/>
      <parameter id="f10" name="Coefficient of Free Cd efflux from Liver Tissue to Liver Blood relative to Liver Blood flow" value="1.98e-08" units="UNITLESS" constant="true"/>
      <parameter id="f11" name="Coefficient of Free Cd influx from Liver Blood to Liver Tissue relative to Liver Blood flow" value="0.65" units="UNITLESS" constant="true"/>
      <parameter id="C14" name="Rate constant of CdMT efflux from Liver Tissue to Liver Blood" units="L_PER_DAY" constant="false"/>
      <parameter id="C13" name="Rate constant of Free Cd efflux from Liver Tissue to Liver Blood" units="L_PER_DAY" constant="false"/>
      <parameter id="C12" name="Rate constant of Free Cd influx from Liver Blood to Liver Tissue" units="L_PER_DAY" constant="false"/>
      <parameter id="k12" name="Rate constant of dissociation of CdMT into Free Cd and MT in Liver Tissue" value="20" units="PER_DAY" constant="true"/>
      <parameter id="k13" name="Rate constant of association of Free Cd and MT to form CdMT in Liver Tissue" value="667" units="PER_DAY" constant="true"/>
      <parameter id="C15" name="Rate constant of Free Cd excretion from Liver Tissue to feces via bile" value="0.00165" units="PER_DAY" constant="true"/>
      <parameter id="f15" name="Coefficient of CdMT filtration from Kidney Blood to Filtrate relative to Kidney Blood flow" value="0.023" units="UNITLESS" constant="true"/>
      <parameter id="f16" name="Coefficient of Free Cd filtration from Kidney Blood to Filtrate relative to Kidney Blood flow" value="0.099" units="UNITLESS" constant="true"/>
      <parameter id="k15" name="Rate constant of CdMT filtration from Kidney Blood to Filtrate" units="L_PER_DAY" constant="false"/>
      <parameter id="k16" name="Rate constant of Free Cd filtration from Kidney Blood to Filtrate" units="L_PER_DAY" constant="false"/>
      <parameter id="C17x" name="Age-dependent rate constant of CdMT reabsorption from Filtrate to Kidney Tissue" value="0.95" units="PER_DAY" constant="true"/>
      <parameter id="C17" name="Rate constant of CdMT reabsorption from Filtrate to Kidney Tissue for age &lt;= 30" units="PER_DAY" constant="false"/>
      <parameter id="k18" name="Rate constant of Free Cd excretion from Filtrate to urine" value="1" units="PER_DAY" constant="true"/>
      <parameter id="C21" name="Coefficient of increase of rate constant of Free Cd and CdMT excretion from Kidney Tissue to urine for age &gt;30 (unit in /d y)" value="7.7e-07" constant="true"/>
      <parameter id="C19x" name="Age-dependent rate constant of Free Cd and CdMT excretion from Kidney Tissue to urine" value="9.8e-05" units="PER_DAY" constant="true"/>
      <parameter id="C19" name="Rate constant of Free Cd and CdMT excretion from Kidney Tissue to urine for age &lt;= 30" units="PER_DAY" constant="false"/>
      <parameter id="k20" name="Rate constant of dissociation of CdMT in Kidney Tissue into Free Cd and MT in Kidney Tissue" value="20" units="PER_DAY" constant="true"/>
      <parameter id="k21" name="Rate constant of association of Free Cd and MT to form CdMT in Kidney Tissue" value="11.11" units="PER_DAY" constant="true"/>
      <parameter id="f22" name="Coefficient of Free Cd efflux from Kidney Tissue to Kidney Blood relative to Kidney Blood flow" value="4e-09" units="UNITLESS" constant="true"/>
      <parameter id="C18" name="Rate constant of Free Cd efflux from Kidney Tissue to Kidney Blood" units="L_PER_DAY" constant="false"/>
      <parameter id="f23" name="Coefficient of Free Cd efflux from RB Tissue to RB Blood relative to RB Blood flow" value="2e-05" units="UNITLESS" constant="true"/>
      <parameter id="f24" name="Coefficient of Free Cd influx from RB Blood to RB Tissue relative to RB Blood flow" value="1" units="UNITLESS" constant="true"/>
      <parameter id="C10" name="Rate constant of Free Cd efflux from RB Tissue to RB Blood" units="L_PER_DAY" constant="false"/>
      <parameter id="C9" name="Rate constant of Free Cd influx from RB Blood to RB Tissue" units="L_PER_DAY" constant="false"/>
      <parameter id="C11" name="Rate constant of Cd excretion from RB Tissue to feces representing fecal Cd sourced from intestine excretion and intestine wall sloughing" value="0.0001" units="PER_DAY" constant="true"/>
      <parameter id="PP" name="Free plasma protein" value="1" units="UNITLESS" constant="true"/>
      <parameter id="RBC" name="Free red blood cells" value="1" units="UNITLESS" constant="true"/>
      <parameter id="MTL" name="Free Metallothionine in Liver Tissue" value="1" units="UNITLESS" constant="true"/>
      <parameter id="MTK" name="Free Metallothionine in Kidney Tissue" value="1" units="UNITLESS" constant="true"/>
      <parameter id="CABlood_Free" name="unbound concentration in arterial blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CABlood_PP" name="plasma protein bound concentration in arterial blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CABlood_RBC" name="red blood cell bound concentration in arterial blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVLiverB_Free" name="unbound concentration in liver venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVLiverB_PP" name="protein plasma bound concentration in liver venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVLiverB_RBC" name="red blood cell bound concentration in liver venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CLiverT_Free" name="unbound concentration in liver tissue" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CLiverT_MT" name="metallothionine bound concentration in liver tissue" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVKidneyB_Free" name="unbound concentration in kidney venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVKidneyB_PP" name="protein plasma bound concentration in kidney venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVKidneyB_RBC" name="red blood cell bound concentration in kidney venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CKidneyT_Free" name="unbound concentration in kidney tissue" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CKidneyT_MT" name="metallothionine bound concentration in kidney tissue" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVRBB_Free" name="unbound concentration in rest of body venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVRBB_PP" name="protein plasma bound concentration in rest of body venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CVRBB_RBC" name="red blood cell bound concentration in rest of body venouse blood" units="MicroGM_PER_L" constant="false"/>
      <parameter id="CRBT_Free" name="unbound concentration in rest of body tissue" units="MicroGM_PER_L" constant="false"/>
      <parameter id="uptakeTotal_Lung" name="total daily amount in Lung" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptake1_Lung" name="fraction of total daily amount in Lung to protein plasma bound amount in extra tissue blood" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptakeTotal_GI" name="total daily amount in GI tract" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptake2_Lung" name="fraction of total daily amount in Lung to free amount in extra tissue blood" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptake1_GI" name="fraction of total daily amount in GI tract to protein plasma bound amount in liver blood" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptake2_GI" name="fraction of total daily amount in GI tract to free amount in liver blood" units="MicroGM_PER_DAY" constant="false"/>
    </listOfParameters>
    <listOfInitialAssignments>
      <initialAssignment symbol="ExtraTissueBlood">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VETB </ci>
        </math>
      </initialAssignment>
      <initialAssignment symbol="LiverBlood">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VLiverB </ci>
        </math>
      </initialAssignment>
      <initialAssignment symbol="LiverTissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VLiverT </ci>
        </math>
      </initialAssignment>
      <initialAssignment symbol="KidneyBlood">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VKidneyB </ci>
        </math>
      </initialAssignment>
      <initialAssignment symbol="KidneyTissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VKidneyT </ci>
        </math>
      </initialAssignment>
      <initialAssignment symbol="RestofBodyBlood">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VRBB </ci>
        </math>
      </initialAssignment>
      <initialAssignment symbol="RestofBodyTissue">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VRBT </ci>
        </math>
      </initialAssignment>
    </listOfInitialAssignments>
    <listOfRules>
      <assignmentRule variable="VB">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> FVB </ci>
            <ci> BWl </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VL">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> Iwa </ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci> BWl </ci>
                <ci> BWa </ci>
              </apply>
              <cn> 0.85 </cn>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VLiverB">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> FVLB </ci>
            <ci> VL </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VLiverT">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <ci> FVLB </ci>
            </apply>
            <ci> VL </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VK">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> kwa </ci>
            <apply>
              <power/>
              <apply>
                <divide/>
                <ci> BWl </ci>
                <ci> BWa </ci>
              </apply>
              <cn> 0.84 </cn>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidneyB">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> FVKB </ci>
            <ci> VK </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidneyT">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <ci> FVKB </ci>
            </apply>
            <ci> VK </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="A">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <minus/>
              <ci> VB </ci>
              <ci> VLiverB </ci>
            </apply>
            <ci> VKidneyB </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="B">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <minus/>
              <ci> BWl </ci>
              <ci> VL </ci>
            </apply>
            <ci> VK </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VETB">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <divide/>
            <apply>
              <minus/>
              <ci> A </ci>
              <apply>
                <times/>
                <ci> FVRBB </ci>
                <ci> B </ci>
              </apply>
            </apply>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <ci> FVRBB </ci>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VRB">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <ci> B </ci>
            <ci> VETB </ci>
          </apply>
