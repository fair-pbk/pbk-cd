### PBK Model Template for Cadmium ###

model {{MODEL_NAME}}()

    ## Subject-level physiological parameters
{{SUBJECT_LEVEL_PHYSIOLOGY}}

    ## Compartment volume parameters
{{COMPARTMENT_VOLUME_PARAMETERS}}

    ## Compartment volumes
{{COMPARTMENT_VOLUMES}}

    ## Kinetic parameters
    Fabs = 0.048                        # Fraction of GI-tract Cd retained in epithelium [-]
    Ka = 0.05                           # Rate of transfer of Cd in the GI-tract to uptake pool [/d]
    K_Inhalation_Uptake = 0.05          # Rate of transfer of inhalation intake to uptake pool [/d]
    K_Lung_Intestine = 0.005            # Rate of transfer of Cd in lungs to the GI-tract [/d]
    F_Uptake_Metallothionein = 0.25     # Fraction of uptake pool transferred to metallothionein [-]
    Max_Metallothionein = 1             # Maximum mass of Cd that can bind to metallothionein per day [ug/d]
    K_Plasma_Others = 0.44              # Transfer from plasma to the rest of the body [/d]
    K_Others_Plasma = 0.00014           # Transfer from rest of the body to plasma [/d]
    K_Plasma_Feces = 0.27               # Transfer from plasma to feces [/d]
    K_Plasma_Liver = 0.25               # Transfer from plasma to liver [/d]
    K_Liver_Plasma = 0.00003            # Transfer from liver to plasma [/d]
    K_Liver_Metallothionein = 0.00016   # Transfer from liver to metallothionein [/d]
    K_Liver_Feces = 0.00005             # Transfer from liver to feces [/d]
    K_RBC_Metallothionein = 0.012       # Transfer from red blood cells to metallothionein [/d]
    K_Kidney_Plasma = 0.00001           # Transfer from kidney to plasma [/d]
    Increase_Cd_Urine = 0.0000011       # Temporal factor increasing Cd elimination in urine
    K_Plasma_RBC = 0.04                 # Transfer from plasma to red blood cells [/d]
{{KINETIC_PARAMETERS}}

    # Compartments
    compartment Metallothionein := VMetallothionein
    compartment Liver := VLiver
    compartment Kidney := VKidney
    compartment Feces := VFeces
    compartment Urine := VUrine
    compartment Gut := VGut
    compartment Lung := VLung
    compartment Plasma := VPlasma
    compartment RBC := VRBC
    compartment Others := VOthers

    # Species
    substanceOnly species AGut in Gut                         # Quantity of cadmium in gut [ug]
    substanceOnly species ALiver in Liver                     # Quantity of cadmium in liver [ug]
    substanceOnly species AKidney in Kidney                   # Quantity of cadmium in kidneys [ug]
    substanceOnly species ALung in Lung                       # Quantity of cadmium in lungs [ug]
    substanceOnly species AUrine in Urine                     # Cumulative quantity of cadmium in urine [ug]
    substanceOnly species AFeces in Feces                     # Quantity of cadmium in feces [ug]
    substanceOnly species APlasma in Plasma                   # Quantity of cadmium in plasma [ug]
    substanceOnly species ARBC in RBC                         # Quantity of cadmium in red blood cells [ug]
    substanceOnly species AMetallothionein in Metallothionein # Quantity of cadmium in metallothionein [ug]
    substanceOnly species AOthers in Others                   # Quantity of cadmium in the rest of the body [ug]

    # Initial amounts
    AGut             = 0
    ALiver           = 0
    AKidney          = 0
    ALung            = 0
    AUrine           = 0
    AFeces           = 0
    APlasma          = 0
    ARBC             = 0
    AMetallothionein = 0
    AOthers          = 0

    # Total uptake [ug/d]
    Uptake :=  AGut * Ka * Fabs + ALung * K_Inhalation_Uptake

    # Uptake in Metallothionein [ug/d]
    Uptake_Metallothionein := F_Uptake_Metallothionein * Uptake

    # Transfer from gut to plasma [ug/d]
    Gut_Plasma_NoLimit := (1 - F_Uptake_Metallothionein) * (AGut * Ka * Fabs)
    Gut_Plasma_Limit := (AGut * Ka * Fabs + ALung * K_Lung_Intestine * Fabs) - Max_Metallothionein * ((AGut * Ka * Fabs) / Uptake)
    Gut_Plasma := piecewise(Gut_Plasma_NoLimit, Uptake_Metallothionein < Max_Metallothionein, Gut_Plasma_Limit)

    # Transfer from lung to plasma [ug/d]
    Lung_Plasma_NoLimit := (1 - F_Uptake_Metallothionein) * ALung * K_Inhalation_Uptake
    Lung_Plasma_Limit := ALung * K_Inhalation_Uptake - Max_Metallothionein * (ALung * K_Inhalation_Uptake / Uptake)
    Lung_Plasma := piecewise(Lung_Plasma_NoLimit, Uptake_Metallothionein < Max_Metallothionein, Lung_Plasma_Limit)

{{RATE_RULES}}

    # Reactions
    AGut          -> APlasma;           Gut_Plasma
    AGut          -> AMetallothionein;  AGut * Ka * Fabs - Gut_Plasma
    AGut          -> AFeces;            AGut * Ka * (1 - Fabs)
    ALung         -> APlasma;           Lung_Plasma
    ALung         -> AMetallothionein;  ALung * K_Inhalation_Uptake - Lung_Plasma
    ALung         -> AGut;              ALung * K_Lung_Intestine
    APlasma       -> AOthers;           APlasma * K_Plasma_Others
    APlasma       -> ARBC;              APlasma * K_Plasma_RBC
    APlasma       -> AFeces;            APlasma * K_Plasma_Feces
    APlasma       -> ALiver;            APlasma * K_Plasma_Liver
    ARBC          -> AMetallothionein;  ARBC * K_RBC_Metallothionein
    AMetallothionein -> AKidney;        AMetallothionein * K_Metallothionein_Kidney
    AMetallothionein -> AUrine;         AMetallothionein * (1 - K_Metallothionein_Kidney)
    ALiver        -> APlasma;           ALiver * K_Liver_Plasma
    ALiver        -> AMetallothionein;  ALiver * K_Liver_Metallothionein
    ALiver        -> AFeces;            ALiver * K_Liver_Feces
    AKidney       -> APlasma;           AKidney * K_Kidney_Plasma
    AKidney       -> AUrine;            AKidney * K_Kidney_Urine
    AOthers       -> APlasma;           AOthers * K_Others_Plasma

end
