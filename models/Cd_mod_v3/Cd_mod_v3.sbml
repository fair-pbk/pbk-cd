      <parameter id="UPTAKE_MT" name="Remaining systemic Cd uptake flux to MT" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="UPTAKE_PLASMA" name="Remaining systemic Cd uptake flux to plasma" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptakeMT_Lung" name="Lung contribution to MT uptake flux, allocated in proportion to lung share of total uptake" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptakeMT_GI" name="GI contribution to MT uptake flux, allocated in proportion to GI share of total uptake" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptakePlasma_Lung" name="Lung contribution to plasma uptake flux" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="uptakePlasma_GI" name="GI contribution to plasma uptake flux" units="MicroGM_PER_DAY" constant="false"/>
