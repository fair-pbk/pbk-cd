    <listOfParameters>
      <parameter id="k3" name="First-order transfer rate constant from lung to total systemic uptake" value="0.05" units="PER_DAY" constant="true"/>
      <parameter id="k4" name="First-order transfer rate constant from lung to GI" value="0.005" units="PER_DAY" constant="true"/>
      <parameter metaid="meta_kabs" id="kabs" name="First-order rate constant (added explicitly for unit consistency)" value="1" units="PER_DAY" constant="true">
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:vCard4="http://www.w3.org/2006/vcard/ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/">
            <rdf:Description rdf:about="#meta_kabs">
              <bqmodel:is>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://purl.obolibrary.org/obo/PBPKO_03075"/>
                </rdf:Bag>
              </bqmodel:is>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </parameter>
      <parameter id="k5_h" name="Fraction of absorbed Cd in gut transferred to intestine in males" value="0.05" units="UNITLESS" constant="true"/>
      <parameter id="k5_f" name="Fraction of absorbed Cd in gut transferred to intestine in females" value="0.1" units="UNITLESS" constant="true"/>
      <parameter id="k6" name="First-order transfer rate constant from intestine to total systemic uptake" value="0.05" units="PER_DAY" constant="true"/>
      <parameter id="k7" name="Fraction of total systemic Cd uptake to the metallothionein" value="0.25" units="UNITLESS" constant="true"/>
      <parameter id="k8" name="Maximum Cd flux into the metallothionein" value="1" units="MicroGM_PER_DAY" constant="true"/>
      <parameter id="k_MT_out" name="First-order turnover rate constant for MT-bound Cd (added explicitly for unit consistency)" value="1" units="PER_DAY" constant="true"/>
      <parameter id="k9" name="kinetic constant rate PLASMA -&gt; OTHER tissues" value="0.44" units="PER_DAY" constant="true"/>
      <parameter id="k10" name="kinetic constant rate OTHER tissues -&gt; PLASMA" value="0.00014" units="PER_DAY" constant="true"/>
      <parameter id="k11" name="kinetic constant rate PLASMA -&gt; feces" value="0.27" units="PER_DAY" constant="true"/>
      <parameter id="k12" name="kinetic constant rate PLASMA -&gt; liver" value="0.25" units="PER_DAY" constant="true"/>
      <parameter id="k13" name="kinetic constant rate liver -&gt; PLASMA" value="3e-05" units="PER_DAY" constant="true"/>
      <parameter id="k14" name="kinetic constant rate liver -&gt; MT pool" value="0.00016" units="PER_DAY" constant="true"/>
      <parameter id="k15" name="kinetic constant rate liver -&gt; feces" value="5e-05" units="PER_DAY" constant="true"/>
      <parameter id="kx" name="kinetic constant rate PLASMA -&gt; RBC" value="0.04" units="PER_DAY" constant="true"/>
      <parameter id="k16" name="kinetic constant rate RBC-&gt; MT pool" value="0.012" units="PER_DAY" constant="true"/>
      <parameter id="k17" name="Fraction of MT-bound Cd removal to KIDNEY; remainder goes directly to urine." value="0.95" units="UNITLESS" constant="true"/>
      <parameter id="k18" name="kinetic constant rate KIDNEY -&gt; PLASMA" value="1e-05" units="PER_DAY" constant="true"/>
      <parameter id="k19" name="urine elimination rate constant" value="0.00014" units="PER_DAY" constant="true"/>
      <parameter id="k21" name="Age-dependent increase in kidney-to-urine elimination after age 30" value="1.1e-06" units="PER_YR" constant="true"/>
      <parameter id="k20" name="Fraction of PLASMA + META Cd amounts to calculated whole-blood Cd" value="0.1" units="UNITLESS" constant="true"/>
      <parameter id="sex" name="sex discrimination" value="2" units="UNITLESS" constant="true"/>
      <parameter id="Age" value="30" constant="true"/>
      <parameter id="Delta_BWs3" name="Individual body-weight multiplier reached at age 3" value="1" units="UNITLESS" constant="true"/>
      <parameter id="Delta_creat" name="Individual multiplicative adjustment to predicted urine creatinine output" value="1" units="UNITLESS" constant="true"/>
      <parameter id="Ccord" name="Measured Cd concentration in cord whole blood used to initialize birth Cd amount" value="0" units="MicroGM_PER_DAY" constant="true"/>
      <parameter metaid="meta_year" id="year" name="Age in years" units="YR" constant="false">
