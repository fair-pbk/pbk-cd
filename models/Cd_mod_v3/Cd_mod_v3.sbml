      <parameter id="total_internal" name="Total internal amount" units="MicroGM" constant="false"/>
      <parameter id="Excreted" name="Total amount excreted" units="MicroGM" constant="false"/>
    </listOfParameters>
    <listOfInitialAssignments>
      <initialAssignment symbol="RBC">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> Acord_total </ci>
        </math>
      </initialAssignment>
    </listOfInitialAssignments>
    <listOfRules>
      <assignmentRule variable="year">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <apply>
              <divide/>
              <csymbol encoding="text" definitionURL="http://www.sbml.org/sbml/symbols/time"> time </csymbol>
              <cn type="integer"> 365 </cn>
            </apply>
            <ci> Age </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Delta_BW">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <piecewise>
            <piece>
              <apply>
                <plus/>
                <cn type="integer"> 1 </cn>
                <apply>
                  <divide/>
                  <apply>
                    <times/>
                    <apply>
                      <minus/>
                      <ci> Delta_BWs3 </ci>
                      <cn type="integer"> 1 </cn>
                    </apply>
                    <ci> year </ci>
                    <cn type="integer"> 365 </cn>
                  </apply>
                  <cn type="integer"> 1095 </cn>
                </apply>
              </apply>
              <apply>
                <leq/>
                <apply>
                  <times/>
                  <ci> year </ci>
                  <cn type="integer"> 365 </cn>
                </apply>
                <cn type="integer"> 1095 </cn>
              </apply>
            </piece>
            <otherwise>
              <ci> Delta_BWs3 </ci>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
      <assignmentRule variable="BW_male">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <piecewise>
            <piece>
              <apply>
                <times/>
                <apply>
                  <ci> BW_male_lifetime </ci>
                  <apply>
                    <times/>
                    <ci> year </ci>
                    <cn type="integer"> 12 </cn>
                  </apply>
                </apply>
                <ci> Delta_BW </ci>
              </apply>
              <apply>
                <leq/>
                <ci> year </ci>
                <cn type="integer"> 79 </cn>
              </apply>
            </piece>
            <otherwise>
              <apply>
                <times/>
                <cn type="integer"> 76 </cn>
                <ci> Delta_BW </ci>
              </apply>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
      <assignmentRule variable="BW_female">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <piecewise>
            <piece>
              <apply>
                <times/>
                <apply>
                  <ci> BW_female_lifetime </ci>
                  <apply>
                    <times/>
                    <ci> year </ci>
                    <cn type="integer"> 12 </cn>
                  </apply>
                </apply>
                <ci> Delta_BW </ci>
              </apply>
              <apply>
                <leq/>
                <ci> year </ci>
                <cn type="integer"> 79 </cn>
              </apply>
            </piece>
            <otherwise>
              <apply>
                <times/>
                <cn type="integer"> 68 </cn>
                <ci> Delta_BW </ci>
              </apply>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
      <assignmentRule variable="wbw">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <piecewise>
            <piece>
              <ci> BW_male </ci>
              <apply>
                <eq/>
                <ci> sex </ci>
                <cn type="integer"> 1 </cn>
              </apply>
            </piece>
            <otherwise>
              <ci> BW_female </ci>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
      <assignmentRule variable="hct_mid">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <apply>
              <minus/>
              <apply>
                <times/>
                <cn type="e-notation"> 1.12815 <sep/> -6 </cn>
                <apply>
                  <power/>
                  <ci> year </ci>
                  <cn type="integer"> 3 </cn>
                </apply>
              </apply>
              <apply>
                <times/>
                <cn> 0.000172362 </cn>
                <apply>
                  <power/>
                  <ci> year </ci>
                  <cn type="integer"> 2 </cn>
                </apply>
              </apply>
            </apply>
            <apply>
              <times/>
              <cn> 0.00815264 </cn>
              <ci> year </ci>
            </apply>
            <cn> 0.327363 </cn>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="hct">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <piecewise>
            <piece>
              <cn> 0.359 </cn>
              <apply>
                <leq/>
                <ci> year </ci>
                <cn type="integer"> 2 </cn>
