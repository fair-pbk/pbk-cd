      <parameter id="K_Lung_Intestine" name="Rate of absorption from Lung to intestine" value="0.005" units="PER_DAY" constant="true"/>
      <parameter id="F_Uptake_Metallothionein" name="Fraction of uptake pool transferred to metallothionein" value="0.25" units="UNITLESS" constant="true"/>
      <parameter id="Max_Metallothionein" name="Maximal dose in metallothionein added daily" value="1" units="MicroGM_PER_DAY" constant="true"/>
      <parameter id="K_Plasma_Others" name="Transfer from plasma to the rest of the body" value="0.44" units="PER_DAY" constant="true"/>
      <parameter id="K_Others_Plasma" name="Transfer from rest of the body to plasma" value="0.00014" units="PER_DAY" constant="true"/>
      <parameter metaid="meta_K_Plasma_Feces" id="K_Plasma_Feces" name="Transfer from plasma to feces" value="0.27" units="PER_DAY" constant="true">
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:vCard4="http://www.w3.org/2006/vcard/ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/">
