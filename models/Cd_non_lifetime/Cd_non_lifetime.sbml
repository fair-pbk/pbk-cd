      <parameter id="Ka" name="Transfer from intestine to total uptake" value="0.05" units="PER_DAY" constant="true"/>
      <parameter metaid="meta_K_Inhalation_Uptake" id="K_Inhalation_Uptake" name="Transfer from lung to total intake" value="0.05" units="PER_DAY" constant="true">
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:vCard4="http://www.w3.org/2006/vcard/ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/">
            <rdf:Description rdf:about="#meta_K_Inhalation_Uptake">
