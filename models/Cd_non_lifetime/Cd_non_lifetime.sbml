                  <rdf:li rdf:resource="http://purl.obolibrary.org/obo/PBPKO_00498"/>
                </rdf:Bag>
              </bqmodel:is>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </parameter>
      <parameter id="Increase_Cd_Urine" name="Temporal factor increasing Cd elimination in urine" value="1.1e-06" units="PER_DAY" constant="true"/>
      <parameter id="K_Plasma_RBC" name="Transfer from plasma to red blood cells" value="0.04" units="PER_DAY" constant="true"/>
      <parameter id="K_Metallothionein_Kidney" name="Transfer from metallothionein to kidney" value="0.95" units="PER_DAY" constant="true"/>
      <parameter metaid="meta_K_Kidney_Urine" id="K_Kidney_Urine" name="Transfer from kidney to urine" value="0.00014" units="PER_DAY" constant="true">
        <annotation>
          <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#" xmlns:dcterms="http://purl.org/dc/terms/" xmlns:vCard="http://www.w3.org/2001/vcard-rdf/3.0#" xmlns:vCard4="http://www.w3.org/2006/vcard/ns#" xmlns:bqbiol="http://biomodels.net/biology-qualifiers/" xmlns:bqmodel="http://biomodels.net/model-qualifiers/">
            <rdf:Description rdf:about="#meta_K_Kidney_Urine">
              <bqmodel:is>
                <rdf:Bag>
                  <rdf:li rdf:resource="http://purl.obolibrary.org/obo/PBPKO_00237"/>
                </rdf:Bag>
              </bqmodel:is>
            </rdf:Description>
          </rdf:RDF>
        </annotation>
      </parameter>
      <parameter id="Uptake" name="Total (systemic) uptake" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="Uptake_Metallothionein" name="Transfer from total uptake to metallothionein" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="Gut_Plasma_NoLimit" name="Transfer from gut to plasma with unsaturated metallothionein" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="Gut_Plasma_Limit" name="Transfer from gut to plasma with saturated metallothionein" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="Gut_Plasma" name="Transfer from gut to plasma" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="Lung_Plasma_NoLimit" name="Transfer from lung to plasma with unsaturated metallothionein" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="Lung_Plasma_Limit" name="Transfer from lung to plasma with saturated metallothionein" units="MicroGM_PER_DAY" constant="false"/>
      <parameter id="Lung_Plasma" name="Transfer from lung to plasma" units="MicroGM_PER_DAY" constant="false"/>
    </listOfParameters>
    <listOfRules>
      <assignmentRule variable="Metallothionein">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VMetallothionein </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Liver">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VLiver </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Kidney">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VKidney </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Feces">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VFeces </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Urine">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VUrine </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Gut">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VGut </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Lung">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VLung </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Plasma">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VPlasma </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="RBC">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VRBC </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Others">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VOthers </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="VMetallothionein">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn type="integer"> 1 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="VLiver">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VLiverc </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VKidney">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VKidneyc </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VFeces">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn type="integer"> 1 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="VUrine">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn type="integer"> 1 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="VGut">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VGutc </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VLung">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VLungc </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VBlood">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VBloodc </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VPlasma">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VBlood </ci>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <ci> HCT </ci>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VRBC">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VBlood </ci>
            <ci> HCT </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="VOthers">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> BW </ci>
            <apply>
              <minus/>
              <apply>
                <minus/>
                <apply>
                  <minus/>
                  <apply>
                    <minus/>
                    <apply>
                      <minus/>
                      <cn type="integer"> 1 </cn>
                      <ci> VLiverc </ci>
                    </apply>
                    <ci> VKidneyc </ci>
                  </apply>
                  <ci> VGutc </ci>
                </apply>
                <ci> VLungc </ci>
              </apply>
              <ci> VBloodc </ci>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Uptake">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <plus/>
            <apply>
              <times/>
              <ci> AGut </ci>
              <ci> Ka </ci>
              <ci> Fabs </ci>
            </apply>
            <apply>
              <times/>
              <ci> ALung </ci>
              <ci> K_Inhalation_Uptake </ci>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Uptake_Metallothionein">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> F_Uptake_Metallothionein </ci>
            <ci> Uptake </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Gut_Plasma_NoLimit">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <ci> F_Uptake_Metallothionein </ci>
            </apply>
            <ci> AGut </ci>
            <ci> Ka </ci>
            <ci> Fabs </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Gut_Plasma_Limit">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <plus/>
              <apply>
                <times/>
                <ci> AGut </ci>
                <ci> Ka </ci>
                <ci> Fabs </ci>
              </apply>
              <apply>
                <times/>
                <ci> ALung </ci>
                <ci> K_Lung_Intestine </ci>
                <ci> Fabs </ci>
              </apply>
            </apply>
            <apply>
              <times/>
              <ci> Max_Metallothionein </ci>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci> AGut </ci>
                  <ci> Ka </ci>
                  <ci> Fabs </ci>
                </apply>
                <ci> Uptake </ci>
              </apply>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Gut_Plasma">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <piecewise>
            <piece>
              <ci> Gut_Plasma_NoLimit </ci>
              <apply>
                <lt/>
                <ci> Uptake_Metallothionein </ci>
                <ci> Max_Metallothionein </ci>
              </apply>
            </piece>
            <otherwise>
              <ci> Gut_Plasma_Limit </ci>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
      <assignmentRule variable="Lung_Plasma_NoLimit">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn type="integer"> 1 </cn>
              <ci> F_Uptake_Metallothionein </ci>
            </apply>
            <ci> ALung </ci>
            <ci> K_Inhalation_Uptake </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Lung_Plasma_Limit">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <minus/>
            <apply>
              <times/>
              <ci> ALung </ci>
              <ci> K_Inhalation_Uptake </ci>
            </apply>
            <apply>
              <times/>
              <ci> Max_Metallothionein </ci>
              <apply>
                <divide/>
                <apply>
                  <times/>
                  <ci> ALung </ci>
                  <ci> K_Inhalation_Uptake </ci>
                </apply>
                <ci> Uptake </ci>
              </apply>
            </apply>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Lung_Plasma">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <piecewise>
            <piece>
              <ci> Lung_Plasma_NoLimit </ci>
              <apply>
                <lt/>
                <ci> Uptake_Metallothionein </ci>
                <ci> Max_Metallothionein </ci>
              </apply>
            </piece>
            <otherwise>
              <ci> Lung_Plasma_Limit </ci>
            </otherwise>
          </piecewise>
        </math>
      </assignmentRule>
    </listOfRules>
    <listOfReactions>
      <reaction id="_J0" reversible="true">
        <listOfReactants>
          <speciesReference species="AGut" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="APlasma" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <ci> Gut_Plasma </ci>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="_J1" reversible="true">
        <listOfReactants>
          <speciesReference species="AGut" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="AMetallothionein" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <minus/>
              <apply>
                <times/>
                <ci> AGut </ci>
                <ci> Ka </ci>
                <ci> Fabs </ci>
              </apply>
              <ci> Gut_Plasma </ci>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="_J2" reversible="true">
        <listOfReactants>
          <speciesReference species="AGut" stoichiometry="1" constant="true"/>
        </listOfReactants>
        <listOfProducts>
          <speciesReference species="AFeces" stoichiometry="1" constant="true"/>
        </listOfProducts>
        <kineticLaw>
          <math xmlns="http://www.w3.org/1998/Math/MathML">
            <apply>
              <times/>
              <ci> AGut </ci>
              <ci> Ka </ci>
              <apply>
                <minus/>
                <cn type="integer"> 1 </cn>
                <ci> Fabs </ci>
              </apply>
            </apply>
          </math>
        </kineticLaw>
      </reaction>
      <reaction id="_J3" reversible="true">
        <listOfReactants>
          <speciesReference species="ALung" stoichiometry="1" constant="true"/>
